{
  "name": "@myoldtime/opencode-codex-imagegen",
  "version": "1.1.0",
  "type": "module",
  "description": "OpenCode V2 background image generation and editing with session-scoped Codex, OpenRouter, AIHubMix and Google Gemini failover.",
  "license": "MIT",
  "author": "MyOldTime",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MyOldTime/opencode-codex-imagegen.git"
  },
  "homepage": "https://github.com/MyOldTime/opencode-codex-imagegen#readme",
  "bugs": {
    "url": "https://github.com/MyOldTime/opencode-codex-imagegen/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "image-generation",
    "responses-api",
    "chatgpt",
    "codex",
    "openrouter",
    "aihubmix",
    "gemini"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "parameters.js",
    "images.js",
    "codex.js",
    "google.js",
    "routing.js",
    "errors.js",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node --check index.js && node --check parameters.js && node --check images.js && node --check codex.js && node --check google.js && node --check routing.js && node --check errors.js && node --check test.mjs && node --check release.test.mjs",
    "test": "node --test test.mjs release.test.mjs",
    "prepublishOnly": "npm run check && npm test",
    "publish:npm": "npm publish --registry=https://registry.npmjs.org --@myoldtime:registry=https://registry.npmjs.org --access=public",
    "publish:github": "npm publish --registry=https://npm.pkg.github.com --@myoldtime:registry=https://npm.pkg.github.com --access=public"
  },
  "engines": {
    "node": ">=20.16"
  },
  "dependencies": {
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0"
  }
}
